      <aliases enabled='yes' />
      <column caption='Age Group' datatype='string' name='[Calculation_0936843122720768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &gt;=18 AND [age] &lt;=30 THEN &quot;Teenager&quot;&#13;&#10;ELSEIF [age] &lt;=40 THEN &quot;Young Adult&quot;&#13;&#10;ELSEIF [age] &lt;=50 THEN &quot;Adult&quot;&#13;&#10;ELSEIF [age] &lt;=60 THEN &quot;Middle Age&quot;&#13;&#10;ELSEIF [age] &lt;=70 THEN &quot;Senior&quot;&#13;&#10;ELSE &quot;Old&quot;&#13;&#10;END' />
      </column>
      <column caption='BMI Category' datatype='string' name='[Calculation_1772747126022144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bmi] &lt; 18.5 THEN &quot;Underweight&quot;&#13;&#10;ELSEIF [bmi] &lt; 25 THEN &quot;Normal&quot;&#13;&#10;ELSEIF [bmi] &lt; 30 THEN &quot;Overweight&quot;&#13;&#10;ELSE &quot;Obese&quot;&#13;&#10;END' />
      </column>
      <column caption='Donut Circle' datatype='integer' name='[Calculation_1772747156369409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Exercise Level Category' datatype='string' name='[Calculation_1772747162173442]' role='dimension' type='nominal'>
